{
  "name": "paratera",
  "match_filename": ["paratera"],
  "match_headers": ["配置描述", "费用(元)"],
  "column_mapping": {
    "bill_start": ["账单开始时间"],
    "project": ["资源名称"],
    "model": ["模型"],
    "cost": ["费用(元)"]
  },
  "defaults": {
    "platform": "Paratera",
    "currency": "CNY"
  },
  "type_map": {
    "输入": "input",
    "输出": "output",
    "文本输入": "input",
    "文本输出": "output",
    "图片输入": "input",
    "图片输出": "output",
    "缓存输出": "output",
    "缓存输入": "cache_input"
  },
  "skip_types": ["缓存存储"],
  "model_map": {
    "DeepSeek-V4-Flash": "DeepSeek-V4-Flash",
    "DeepSeek-V4-Pro": "DeepSeek-V4-Pro",
    "DeepSeek-V4.1-Flash": "DeepSeek-V4.1-Flash",
    "Qwen3.5-122B-A10B": "Qwen3.5-122B-A10B",
    "Qwen3.5-35B-A3B": "Qwen3.5-35B-A3B",
    "Qwen3.6-Plus": "Qwen3.6-Plus",
    "Kimi-K2.5": "Kimi-K2.5",
    "GLM-5": "GLM-5"
  },
  "parse": {
    "skip_if": {
      "结算状态": ["结算中"]
    },
    "extract": {
      "column": "配置描述",
      "pattern": "^(\\S+)\\s*:\\s*([\\d,]+)\\s*tokens?\\s*$",
      "group_type": 1,
      "group_tokens": 2
    }
  }
}
